    <!-- JAVASCRIPT APP LOGIC -->
    <script>
        /* -------------------------------------------------------------
         * 1. THREE.JS INTERACTIVE FLOATING 2D 'QUANA CANNON' LETTERS & IN-PLANE WORK CIRCLES
         * ------------------------------------------------------------- */
        let qScene, qCamera, qRenderer, isQMouseDown = false, qPrevMouse = { x: 0, y: 0 };
        let letterObjects = [];
        let bubbleObjects = [];
        let mouseWorldPos = new THREE.Vector3(999, 999, 0);
        let orderFactor = 0; // 0 = scrambled initial state, 1 = ordered into "QUANA CANNON"

        // UNIFORM FONT THICKNESS AND SIZE (900 Weight, 175px Size) ACROSS FLOATING LETTERS
        const lettersData = [
            // QUANA (Top Row)
            { char: 'Q', font: '900 175px "Cormorant Garamond", serif', homeX: -56, homeY: 18 },
            { char: 'U', font: '900 175px "Syne", sans-serif', homeX: -28, homeY: 18 },
            { char: 'A', font: '900 175px "Instrument Serif", serif', homeX:   0, homeY: 18 },
            { char: 'N', font: '900 175px "Archivo Black", sans-serif', homeX:  28, homeY: 18 },
            { char: 'A', font: '900 175px "Bodoni Moda", serif', homeX:  56, homeY: 18 },
            // CANNON (Bottom Row)
            { char: 'C', font: '900 175px "Cormorant Garamond", serif', homeX: -70, homeY: -18 },
            { char: 'A', font: '900 175px "Space Grotesk", sans-serif', homeX: -42, homeY: -18 },
            { char: 'N', font: '900 175px "Playfair Display", serif', homeX: -14, homeY: -18 },
            { char: 'N', font: '900 175px "Cinzel", serif', homeX:  14, homeY: -18 },
            { char: 'O', font: '900 175px "Syne", sans-serif', homeX:  42, homeY: -18 },
            { char: 'N', font: '900 175px "Instrument Serif", serif', homeX:  70, homeY: -18 }
        ];

        // SPREAD OUT WORK CIRCLES DATA (IN-PLANE WITH 3D SCENE)
        const workBubblesData = [
            { id: 1, img: "https://images.unsplash.com/photo-1618005182384-a83a8bd57fbe?q=80&w=600", homeX: -115, homeY: 48 },
            { id: 4, img: "https://images.unsplash.com/photo-1578749556568-bc2c40e68b61?q=80&w=600", homeX: 115, homeY: 52 },
            { id: 5, img: "https://images.unsplash.com/photo-1565193566173-7a0ee3dbe261?q=80&w=600", homeX: -125, homeY: -48 },
            { id: 2, img: "https://images.unsplash.com/photo-1635070041078-e363dbe005cb?q=80&w=600", homeX: 120, homeY: -45 },
            { id: 3, img: "https://images.unsplash.com/photo-1550684848-fac1c5b4e853?q=80&w=600", homeX: 0, homeY: 65 }
        ];

        function createLetterTexture(item) {
            const canvas = document.createElement('canvas');
            canvas.width = 256;
            canvas.height = 256;
            const ctx = canvas.getContext('2d');

            // Transparent background - isolate text without box background
            ctx.clearRect(0, 0, 256, 256);

            // Saturated Lemon Green (#D5EE10) isolated text with uniform font size & weight
            ctx.fillStyle = '#D5EE10';
            ctx.font = item.font || '900 175px "Archivo Black", sans-serif';
            ctx.textAlign = 'center';
            ctx.textBaseline = 'middle';
            ctx.fillText(item.char, 128, 134);

            const texture = new THREE.CanvasTexture(canvas);
            texture.needsUpdate = true;
            return texture;
        }

        function updateAllLetterTextures() {
            letterObjects.forEach(obj => {
                const newTex = createLetterTexture(obj.itemData);
                obj.mesh.material.map.dispose();
                obj.mesh.material.map = newTex;
                obj.mesh.material.needsUpdate = true;
            });
        }

        function init3DLetters() {
            const container = document.getElementById('q-canvas-container');
            if (!container || container.querySelector('canvas')) return;

            const width = container.clientWidth;
            const height = container.clientHeight;

            qScene = new THREE.Scene();
            qCamera = new THREE.PerspectiveCamera(45, width / height, 0.1, 1000);
            qCamera.position.z = 170;

            qRenderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });
            qRenderer.setSize(width, height);
            qRenderer.setPixelRatio(window.devicePixelRatio);
            container.appendChild(qRenderer.domElement);

            // Lighting setup
            const ambientLight = new THREE.AmbientLight(0xffffff, 1.2);
            qScene.add(ambientLight);

            // 1. Build 2D Flat Isolated Letter Planes
            const geo = new THREE.PlaneGeometry(26, 26);

            letterObjects = lettersData.map((item) => {
                const frontTex = createLetterTexture(item);
                const mat = new THREE.MeshBasicMaterial({ 
                    map: frontTex, 
                    transparent: true, 
                    alphaTest: 0.05,
                    side: THREE.DoubleSide 
                });

                const mesh = new THREE.Mesh(geo, mat);
                qScene.add(mesh);

                // Scrambled Initial Positions across canvas space
                const scrambleX = (Math.random() - 0.5) * 320;
                const scrambleY = (Math.random() - 0.5) * 220;
                const scrambleZ = 0;

                const scrambleRot = new THREE.Euler(0, 0, (Math.random() - 0.5) * 2.8);

                mesh.position.set(scrambleX, scrambleY, scrambleZ);
                mesh.rotation.copy(scrambleRot);

                return {
                    mesh: mesh,
                    char: item.char,
                    itemData: item,
                    homePos: new THREE.Vector3(item.homeX, item.homeY, 0),
                    scramblePos: new THREE.Vector3(scrambleX, scrambleY, scrambleZ),
                    currPos: new THREE.Vector3(scrambleX, scrambleY, scrambleZ),
                    velocity: new THREE.Vector3(0, 0, 0),
                    rotVelocity: new THREE.Vector3(0, 0, (Math.random() - 0.5) * 0.04),
                    radius: 13
                };
            });

            // Re-render letter canvas textures when Google Web Fonts finish loading
            if (document.fonts && document.fonts.ready) {
                document.fonts.ready.then(() => {
                    setTimeout(updateAllLetterTextures, 150);
                });
            }

            // 2. Build In-Plane Work Image Circles (Same Scene Plane z=0)
            const textureLoader = new THREE.TextureLoader();
            const circleGeo = new THREE.CircleGeometry(16, 64);

            bubbleObjects = workBubblesData.map((item) => {
                const texture = textureLoader.load(item.img);
                const mat = new THREE.MeshBasicMaterial({ 
                    map: texture, 
                    side: THREE.DoubleSide 
                });

                const mesh = new THREE.Mesh(circleGeo, mat);
                mesh.userData = { id: item.id };
                qScene.add(mesh);

                const initPos = new THREE.Vector3(item.homeX, item.homeY, 0);
                mesh.position.copy(initPos);

                return {
                    mesh: mesh,
                    id: item.id,
                    homePos: initPos.clone(),
                    currPos: initPos.clone(),
                    velocity: new THREE.Vector3(0, 0, 0),
                    radius: 16
                };
            });

            // Track Mouse to align "QUANA CANNON" and push objects
            container.addEventListener('mousemove', (e) => {
                const rect = container.getBoundingClientRect();
                const mouseX = ((e.clientX - rect.left) / rect.width) * 2 - 1;
                const mouseY = -((e.clientY - rect.top) / rect.height) * 2 + 1;

                const vector = new THREE.Vector3(mouseX, mouseY, 0.5);
                vector.unproject(qCamera);
                const dir = vector.sub(qCamera.position).normalize();
                const distance = -qCamera.position.z / dir.z;
                mouseWorldPos.copy(qCamera.position).add(dir.multiplyScalar(distance));

                orderFactor = Math.min(1.0, orderFactor + 0.06);

                // Raycast for hover pointer on circles
                const raycaster = new THREE.Raycaster();
                const mouseVec = new THREE.Vector2(mouseX, mouseY);
                raycaster.setFromCamera(mouseVec, qCamera);
                const intersects = raycaster.intersectObjects(bubbleObjects.map(b => b.mesh));
                if (intersects.length > 0) {
                    container.style.cursor = 'pointer';
                } else {
                    container.style.cursor = 'grab';
                }
            });

            container.addEventListener('click', (e) => {
                const rect = container.getBoundingClientRect();
                const mouseX = ((e.clientX - rect.left) / rect.width) * 2 - 1;
                const mouseY = -((e.clientY - rect.top) / rect.height) * 2 + 1;
                const raycaster = new THREE.Raycaster();
                raycaster.setFromCamera(new THREE.Vector2(mouseX, mouseY), qCamera);
                const intersects = raycaster.intersectObjects(bubbleObjects.map(b => b.mesh));
                if (intersects.length > 0) {
                    const hitObj = intersects[0].object;
                    if (hitObj.userData && hitObj.userData.id) {
                        openModal(hitObj.userData.id);
                    }
                }
            });

            // Physics & In-Plane Collisions Animation Loop
            function animateLetters() {
                requestAnimationFrame(animateLetters);

                orderFactor = Math.min(1.0, orderFactor + 0.0015);

                // A. Individual Letter Dynamics
                letterObjects.forEach((obj, idx) => {
                    const targetPos = new THREE.Vector3().lerpVectors(obj.scramblePos, obj.homePos, orderFactor);

                    const time = Date.now() * 0.0025 + idx;
                    targetPos.y += Math.sin(time) * 3.5;
                    targetPos.x += Math.cos(time * 0.8) * 2.5;

                    const springForce = targetPos.clone().sub(obj.currPos).multiplyScalar(0.05);
                    obj.velocity.add(springForce);
                    obj.velocity.multiplyScalar(0.86);

                    // Mouse Repulsion Force
                    const distToMouse = obj.currPos.distanceTo(mouseWorldPos);
                    if (distToMouse < 40 && distToMouse > 0.1) {
                        const pushDir = obj.currPos.clone().sub(mouseWorldPos).normalize();
                        const force = (40 - distToMouse) * 0.5;
                        obj.velocity.add(pushDir.multiplyScalar(force));
                    }

                    obj.currPos.add(obj.velocity);
                    obj.mesh.position.copy(obj.currPos);

                    obj.mesh.rotation.z += (0 - obj.mesh.rotation.z) * (0.05 * orderFactor) + obj.rotVelocity.z * (1 - orderFactor);
                });

                // B. Individual Work Circle Dynamics
                bubbleObjects.forEach((bubble, idx) => {
                    const targetPos = bubble.homePos.clone();
                    const time = Date.now() * 0.002 + idx * 1.5;
                    targetPos.y += Math.sin(time) * 4;
                    targetPos.x += Math.cos(time * 0.7) * 3;

                    const springForce = targetPos.sub(bubble.currPos).multiplyScalar(0.04);
                    bubble.velocity.add(springForce);
                    bubble.velocity.multiplyScalar(0.88);

                    // Mouse Repulsion Force on Circles
                    const distToMouse = bubble.currPos.distanceTo(mouseWorldPos);
                    if (distToMouse < 45 && distToMouse > 0.1) {
                        const pushDir = bubble.currPos.clone().sub(mouseWorldPos).normalize();
                        const force = (45 - distToMouse) * 0.6;
                        bubble.velocity.add(pushDir.multiplyScalar(force));
                    }

                    bubble.currPos.add(bubble.velocity);
                    bubble.mesh.position.copy(bubble.currPos);
                });

                // C. Inter-Letter Collision Physics
                for (let i = 0; i < letterObjects.length; i++) {
                    for (let j = i + 1; j < letterObjects.length; j++) {
                        const l1 = letterObjects[i];
                        const l2 = letterObjects[j];
                        const dist = l1.currPos.distanceTo(l2.currPos);
                        const minDist = l1.radius + l2.radius;

                        if (dist < minDist && dist > 0.1) {
                            const overlap = (minDist - dist) * 0.5;
                            const collideDir = l1.currPos.clone().sub(l2.currPos).normalize();
                            l1.currPos.add(collideDir.clone().multiplyScalar(overlap));
                            l2.currPos.sub(collideDir.clone().multiplyScalar(overlap));
                            l1.velocity.add(collideDir.clone().multiplyScalar(overlap * 0.35));
                            l2.velocity.sub(collideDir.clone().multiplyScalar(overlap * 0.35));
                        }
                    }
                }

                // D. In-Plane DIRECT Collision Physics Between Letters & Work Circles
                for (let i = 0; i < letterObjects.length; i++) {
                    for (let j = 0; j < bubbleObjects.length; j++) {
                        const letter = letterObjects[i];
                        const bubble = bubbleObjects[j];
                        const dist = letter.currPos.distanceTo(bubble.currPos);
                        const minDist = letter.radius + bubble.radius + 2;

                        if (dist < minDist && dist > 0.1) {
                            const overlap = (minDist - dist);
                            const collideDir = letter.currPos.clone().sub(bubble.currPos).normalize();
                            
                            letter.currPos.add(collideDir.clone().multiplyScalar(overlap * 0.5));
                            bubble.currPos.sub(collideDir.clone().multiplyScalar(overlap * 0.5));

                            letter.velocity.add(collideDir.clone().multiplyScalar(overlap * 0.4));
                            bubble.velocity.sub(collideDir.clone().multiplyScalar(overlap * 0.4));
                        }
                    }
                }

                // E. Inter-Bubble Collision Physics
                for (let i = 0; i < bubbleObjects.length; i++) {
                    for (let j = i + 1; j < bubbleObjects.length; j++) {
                        const b1 = bubbleObjects[i];
                        const b2 = bubbleObjects[j];
                        const dist = b1.currPos.distanceTo(b2.currPos);
                        const minDist = b1.radius + b2.radius;

                        if (dist < minDist && dist > 0.1) {
                            const overlap = (minDist - dist) * 0.5;
                            const collideDir = b1.currPos.clone().sub(b2.currPos).normalize();
                            b1.currPos.add(collideDir.clone().multiplyScalar(overlap));
                            b2.currPos.sub(collideDir.clone().multiplyScalar(overlap));
                            b1.velocity.add(collideDir.clone().multiplyScalar(overlap * 0.3));
                            b2.velocity.sub(collideDir.clone().multiplyScalar(overlap * 0.3));
                        }
                    }
                }

                qRenderer.render(qScene, qCamera);
            }
            animateLetters();

            window.addEventListener('resize', () => {
                if (!container || !qRenderer) return;
                const w = container.clientWidth;
                const h = container.clientHeight;
                qCamera.aspect = w / h;
                qCamera.updateProjectionMatrix();
                qRenderer.setSize(w, h);
            });
        }

        // Alias for compatibility
        function init3DQ() {
            init3DLetters();
        }

        /* -------------------------------------------------------------
         * 2. THREE.JS 3D GLOBE FOR ABOUT PAGE
         * ------------------------------------------------------------- */
        const globeLocations = [
            { name: "LUBBOCK, TX", lat: 33.5779, lon: -101.8552, tag: "RESIDENCY", desc: "COTTON BELT CLAY FIELDWORK." },
            { name: "XISHUANGBANNA, CHINA", lat: 21.9264, lon: 101.2536, tag: "BIO-ART", desc: "TROPICAL BOTANICAL ACOUSTICS." },
            { name: "CHICAGOLAND, IL", lat: 41.8781, lon: -87.6298, tag: "EXHIBITION", desc: "KINETIC CANOPY INSTALLATION." },
            { name: "WELLESLEY / BOSTON, MA", lat: 42.2968, lon: -71.2924, tag: "RESEARCH", desc: "PORCELAIN GLAZE RESEARCH." },
            { name: "TAIPEI, TAIWAN", lat: 25.0330, lon: 121.5654, tag: "RESIDENCY", desc: "HIGH-FIRE CERAMICS RESIDENCY." },
            { name: "KUALA LUMPUR, MALAYSIA", lat: 3.1390, lon: 101.6869, tag: "INSTALLATION", desc: "E-TEXTILE SOUND INSTALLATION." },
            { name: "JINGDEZHEN, CHINA", lat: 29.2936, lon: 117.2079, tag: "CERAMICS", desc: "PORCELAIN WHEEL THROWING STUDY." },
            { name: "SUKADANA, INDONESIA", lat: -1.2467, lon: 109.9531, tag: "FIELDWORK", desc: "RAINFOREST ACOUSTICS RESEARCH." },
            { name: "SHANGHAI, CHINA", lat: 31.2304, lon: 121.4737, tag: "TRIENNIAL", desc: "NEW MEDIA ART PERFORMANCE." }
        ];

        let gScene, gCamera, gRenderer, gGroup, raycaster, mouse;

        function init3DGlobe() {
            const container = document.getElementById('globe-container');
            if (!container || container.querySelector('canvas')) return;

            const width = container.clientWidth;
            const height = container.clientHeight;

            gScene = new THREE.Scene();
            gCamera = new THREE.PerspectiveCamera(45, width / height, 0.1, 1000);
            gCamera.position.z = 220;

            gRenderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });
            gRenderer.setSize(width, height);
            gRenderer.setPixelRatio(window.devicePixelRatio);
            container.appendChild(gRenderer.domElement);

            gGroup = new THREE.Group();
            gScene.add(gGroup);

            const radius = 65;
            const globeGeo = new THREE.SphereGeometry(radius, 48, 48);
            const globeMat = new THREE.MeshPhongMaterial({ color: 0xFAF8F5, emissive: 0xECE9E2, shininess: 10 });
            gGroup.add(new THREE.Mesh(globeGeo, globeMat));

            const wireGeo = new THREE.SphereGeometry(radius + 0.5, 24, 24);
            const wireMat = new THREE.MeshBasicMaterial({ color: 0xD5EE10, wireframe: true, transparent: true, opacity: 0.25 });
            gGroup.add(new THREE.Mesh(wireGeo, wireMat));

            gScene.add(new THREE.AmbientLight(0xffffff, 0.9));
            const dirLight = new THREE.DirectionalLight(0xffffff, 0.5);
            dirLight.position.set(100, 100, 100);
            gScene.add(dirLight);

            function latLonToVector3(lat, lon, r) {
                const phi = (90 - lat) * (Math.PI / 180);
                const theta = (lon + 180) * (Math.PI / 180);
                return new THREE.Vector3(
                    -(r * Math.sin(phi) * Math.cos(theta)),
                    r * Math.cos(phi),
                    r * Math.sin(phi) * Math.sin(theta)
                );
            }

            const pinsGroup = new THREE.Group();
            globeLocations.forEach(loc => {
                const pos = latLonToVector3(loc.lat, loc.lon, radius + 1.5);
                const pinMesh = new THREE.Mesh(
                    new THREE.SphereGeometry(2.5, 16, 16),
                    new THREE.MeshBasicMaterial({ color: 0x1C1C1A })
                );
                pinMesh.position.copy(pos);
                pinMesh.userData = loc;
                pinsGroup.add(pinMesh);
            });
            gGroup.add(pinsGroup);

            raycaster = new THREE.Raycaster();
            mouse = new THREE.Vector2();

            container.addEventListener('click', (e) => {
                const rect = gRenderer.domElement.getBoundingClientRect();
                mouse.x = ((e.clientX - rect.left) / rect.width) * 2 - 1;
                mouse.y = -((e.clientY - rect.top) / rect.height) * 2 + 1;
                raycaster.setFromCamera(mouse, gCamera);
                const intersects = raycaster.intersectObjects(pinsGroup.children);
                if (intersects.length > 0 && intersects[0].object.userData.name) {
                    const data = intersects[0].object.userData;
                    document.getElementById('globe-title').innerText = data.name;
                    document.getElementById('globe-tag').innerText = data.tag;
                    document.getElementById('globe-desc').innerText = data.desc;
                }
            });

            function animateGlobe() {
                requestAnimationFrame(animateGlobe);
                gGroup.rotation.y += 0.003;
                gRenderer.render(gScene, gCamera);
            }
            animateGlobe();
        }

        /* -------------------------------------------------------------
         * 3. ROUTER & MODAL UTILITIES
         * ------------------------------------------------------------- */
        const projectsData = [
            { id: 1, title: "NEURAL AURA FIELD", categoryBadge: "FINE ART", image: "https://images.unsplash.com/photo-1618005182384-a83a8bd57fbe?q=80&w=1000", story: "BIOFEEDBACK SPECTRAL LIGHT INSTALLATION AT VENICE BIENNALE." },
            { id: 2, title: "QUATERNION MESH", categoryBadge: "FINE ART", image: "https://images.unsplash.com/photo-1635070041078-e363dbe005cb?q=80&w=1000", story: "SUSPENDED KINETIC FIBER OPTIC STRUCTURE AT TATE MODERN." },
            { id: 3, title: "LUMEN CANOPY", categoryBadge: "FINE ART", image: "https://images.unsplash.com/photo-1550684848-fac1c5b4e853?q=80&w=1000", story: "ACOUSTIC MOVEMENT CEILING CANOPY AT MORI ART MUSEUM." },
